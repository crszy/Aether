// DankMaterialShell / Dux Shell (MIT) running inside Caelestia for Windows.
// Generated by dotfiles/dms-port.js from its shell.qml - edit the script, not this file.

import QtQuick
import qs.services as Cae
import Quickshell
import Quickshell.Services.SystemTray
import qs.dms.Common
import qs.dms.DCommon.Common as DC
import qs.dms.Modules
import qs.dms.Modules.Lock
import qs.dms.Services

Scope {
    id: entrypoint

    readonly property bool disableHotReload: Quickshell.env("DMS_DISABLE_HOT_RELOAD") === "1" || Quickshell.env("DMS_DISABLE_HOT_RELOAD") === "true"

    readonly property bool shellReady: !!Quickshell.env("NOTIFY_SOCKET") && dmsShellLoader.status === Loader.Ready && DMSService.isConnected && DMSService.apiVersion >= 38

    onShellReadyChanged: {
        if (shellReady)
            DMSService.sendRequest("shell.ready", {
                "pid": Quickshell.processId
            });
    }


    Component.onCompleted: {
        DC.Style.theme = Theme;
        DC.Style.settings = SettingsData;
        DC.I18n.backend = I18n;
        DC.Paths.backend = Paths;
        DC.Log.backend = Log;
        DC.Host.session = SessionService;
        DC.Host.cache = CacheData;
        DC.Host.files = FilesService;
        DC.Host.hyprlandFocusGrab = Qt.binding(() => CompositorService.useHyprlandFocusGrab);
        DC.Host.ownWindowDecorations = true; // Windows: always DMS's own header
        void IconThemeService.ready;
        // Start SNI registration even when no tray widget is visible.
        void SystemTray.items;
        // Build the polkit agent here, outside incubation: first-touching it from a Connections target during DMSShell's async load crashed QQmlConnections::connectSignalsToMethods.
        void PolkitService.agent;
    }

    Loader {
        id: wallpaperLoader
        active: Cae.WinSettings.wallpaperLayer === "dms" // Windows: Mix & match (off while Wallpaper Engine runs)
        asynchronous: false

        sourceComponent: Scope {
            WallpaperBackground {}
            LockPlacementPreparer {}

            Loader {
                active: SettingsData.blurredWallpaperLayer && CompositorService.isNiri
                asynchronous: false
                sourceComponent: BlurredWallpaperBackground {}
            }
        }
    }

    Loader {
        id: shellCoreLoader
        asynchronous: true
        source: "ShellCore.qml"
        onLoaded: dmsShellLoader.setSource("DMSShell.qml", {
            core: item
        })
    }

    Loader {
        id: dmsShellLoader
        asynchronous: true
    }

    // Windows: apps' title bars in DMS's colours (Settings > Title bars > Themed) while DMS draws the bar
    Binding {
        target: Cae.WinSettings
        property: "titleBarTint"
        value: Theme.surfaceContainer
        when: (Cae.WinSettings.mixBar === "dms" && Cae.WinSettings.titleBars === "themed") || Cae.WinSettings.titleBars === "dms"
        restoreMode: Binding.RestoreValue
    }
    Binding {
        target: Cae.WinSettings
        property: "titleBarTextTint"
        value: Theme.surfaceText
        when: (Cae.WinSettings.mixBar === "dms" && Cae.WinSettings.titleBars === "themed") || Cae.WinSettings.titleBars === "dms"
        restoreMode: Binding.RestoreValue
    }

    // Windows: one wallpaper for every shell - DMS follows Caelestia's (set from any shell's picker)
    function followCaelestiaWallpaper() {
        const p = String(Cae.Wallpapers.actualCurrent || "").split(String.fromCharCode(92)).join("/");
        if (p && SessionData.wallpaperPath !== p)
            SessionData.wallpaperPath = p;
    }
    Connections {
        target: Cae.Wallpapers
        function onActualCurrentChanged() {
            entrypoint.followCaelestiaWallpaper();
        }
    }
    Timer {
        running: true
        interval: 3000
        onTriggered: entrypoint.followCaelestiaWallpaper()
    }
}
