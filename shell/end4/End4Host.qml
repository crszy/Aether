    Connections {
        target: Cae.Wallpapers
        function onActualCurrentChanged() {
            root.followCaelestiaWallpaper();
        }
    }
    Connections {
        target: Config
        function onReadyChanged() {
            root.followCaelestiaWallpaper();
        }
    }

